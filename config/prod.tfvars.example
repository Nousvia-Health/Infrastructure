# Copy this file to config/prod.tfvars and replace all replace-me values.
# Local usage: terraform plan -var-file=config/prod.tfvars
# CI usage: set TF_VAR_FILE=config/prod.tfvars in the protected production environment.

resource_groups = {
  platform = {
    name     = "rg-azure-files-prod"
    location = "eastus"
    tags = {
      environment         = "prod"
      workload            = "azure-files"
      owner               = "replace-me"
      cost_center         = "replace-me"
      data_classification = "confidential"
      managed_by          = "terraform"
    }
  }
}

networks = {
  shared = {
    resource_group_key           = "platform"
    vnet_name                    = "vnet-azure-files-prod"
    vnet_address_space           = ["10.30.0.0/16"]
    private_endpoint_subnet_name = "snet-private-endpoints"
    private_endpoint_subnet_cidr = "10.30.1.0/24"
    nsg_name                     = "nsg-azure-files-prod-private-endpoints"
  }
}

storage_accounts = {
  files = {
    resource_group_key = "platform"
    name               = "replacewithuniquestorage"
    replication_type   = "ZRS"
    file_shares = {
      shared = {
        name     = "shared"
        quota_gb = 100
      }
    }
  }
}

private_endpoints = {
  files = {
    resource_group_key  = "platform"
    network_key          = "shared"
    storage_account_key = "files"
    name                 = "pe-azure-files-prod-file"
  }
}

tags = {
  environment         = "prod"
  workload            = "azure-files"
  owner               = "replace-me"
  cost_center         = "replace-me"
  data_classification = "confidential"
  managed_by          = "terraform"
}
