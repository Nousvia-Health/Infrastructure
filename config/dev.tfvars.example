# Copy this file to config/dev.tfvars and replace all replace-me values.
# Local usage: terraform plan -var-file=config/dev.tfvars
# CI usage: set TF_VAR_FILE=config/dev.tfvars in the workflow environment.

resource_groups = {
  platform = {
    name     = "rg-azure-files-dev"
    location = "eastus"
    tags = {
      environment         = "dev"
      workload            = "azure-files"
      owner               = "replace-me"
      cost_center         = "replace-me"
      data_classification = "internal"
      managed_by          = "terraform"
    }
  }
}

networks = {
  shared = {
    resource_group_key           = "platform"
    vnet_name                    = "vnet-azure-files-dev"
    vnet_address_space           = ["10.20.0.0/16"]
    private_endpoint_subnet_name = "snet-private-endpoints"
    private_endpoint_subnet_cidr = "10.20.1.0/24"
    nsg_name                     = "nsg-azure-files-dev-private-endpoints"
  }
}

storage_accounts = {
  files = {
    resource_group_key = "platform"
    name               = "replacewithuniquestorage"
    replication_type   = "LRS"
    default_share_level_permission = "None"
    file_shares = {
      shared = {
        name     = "shared"
        quota_gb = 100
        role_assignments = {
          # users = {
          #   principal_id         = "replace-with-entra-group-object-id"
          #   principal_type       = "Group"
          #   role_definition_name = "Storage File Data SMB Share Contributor"
          # }
        }
      }
    }
  }
}

private_endpoints = {
  files = {
    resource_group_key  = "platform"
    network_key          = "shared"
    storage_account_key = "files"
    name                 = "pe-azure-files-dev-file"
  }
}

tags = {
  environment         = "dev"
  workload            = "azure-files"
  owner               = "replace-me"
  cost_center         = "replace-me"
  data_classification = "internal"
  managed_by          = "terraform"
}

databricks = {
  resource_group_name          = "rg-nousviahealth-databricks-dev"
  location                     = "eastus2"
  workspace_name               = "nousviahealth-dev"
  managed_resource_group_name  = "rg-nousviahealth-databricks-managed-dev"
  vnet_name                    = "vnet-nousviahealth-databricks-dev"
  vnet_address_space           = ["10.40.0.0/16"]
  public_subnet_name           = "snet-databricks-public"
  public_subnet_cidr           = "10.40.1.0/24"
  private_subnet_name           = "snet-databricks-private"
  private_subnet_cidr           = "10.40.2.0/24"
  private_endpoint_subnet_name  = "snet-private-endpoints"
  private_endpoint_subnet_cidr  = "10.40.3.0/24"
  storage_account_name          = "nousviahealthdbxdev"
  storage_replication_type      = "LRS"
}
